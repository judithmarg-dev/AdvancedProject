# Puerto del servidor Colyseus
PORT=2567
# Dirección del servidor que usa el cliente (Vite expone solo variables VITE_*)
VITE_SERVER_URL=ws://localhost:2567
# LiveKit (audio/video, spec 005). Valores del modo de desarrollo local:
#   docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server --dev --bind 0.0.0.0
# Si falta alguna, el servidor arranca con la voz desactivada. En producción, usa claves propias solo en .env.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
